# ============================================================================
#  kbcollector — образец конфигурации.
#  Скопируйте в .env и заполните локально. Секреты в Git не попадают (.gitignore).
#  Переменные без префикса KBC_ не читаются.
# ============================================================================

# dev | prod
KBC_ENV=dev

# Каталог состояния: БД, архив исходников, вложения до публикации.
# Windows: KBC_DATA_DIR=D:/kbcollector-data
# Ubuntu:  KBC_DATA_DIR=/var/lib/kbcollector
KBC_DATA_DIR=./data

# ---------------------------------------------------------------- Логирование
KBC_LOG_LEVEL=INFO
# true — JSON в stderr (для Docker), false — читаемый вывод
KBC_LOG_JSON=false

# ------------------------------------------------------------------- Telegram
# Токен от @BotFather. Не коммитить.
KBC_TELEGRAM_BOT_TOKEN=
# Allowlist. Пустой список = бот отклоняет всех (безопасное значение по умолчанию).
# Формат: список через запятую или JSON-массив.
KBC_TELEGRAM_ALLOWED_USER_IDS=
KBC_TELEGRAM_ALLOWED_CHAT_IDS=
# Таймаут long polling, секунды (1..50)
KBC_TELEGRAM_POLL_TIMEOUT=50

# ------------------------------------------------------------------------- S3
# Для S3-совместимых провайдеров укажите endpoint; для AWS оставьте пустым.
KBC_S3_ENDPOINT_URL=
KBC_S3_REGION=us-east-1
KBC_S3_BUCKET=
# Префикс vault должен совпадать с префиксом плагина Remotely Save.
# Значение нормализуется: завершающий слэш добавляется автоматически.
KBC_S3_VAULT_PREFIX=vault4-kb01
KBC_S3_ARCHIVE_PREFIX=archive
KBC_S3_BACKUP_PREFIX=backup
KBC_S3_ACCESS_KEY_ID=
KBC_S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------ LLM
# Обогащение необязательно: без настроек публикуется базовая заметка.
# OpenAI-совместимый endpoint (OpenAI, OpenRouter, Ollama, vLLM).
KBC_LLM_BASE_URL=
KBC_LLM_API_KEY=
KBC_LLM_MODEL=
KBC_LLM_TIMEOUT_SECONDS=60

# --------------------------------------------------------------- Импорт HTML
# Каталог экспорта Telegram Desktop: messages.html и каталоги photos/files/…
KBC_HTML_EXPORT_DIR=
# chat_id, к которому относится экспорт. В HTML его нет, поэтому он задаётся здесь
# (иначе импорт невозможен — см. docs/adr/0003).
KBC_HTML_CHAT_ID=
